# Copy to .env.bot (ignored by git); never commit real credentials.
TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
BOT_USERNAME=tg_channel_parse_bot
BOT_DATA_DIR=data/bot
BOT_MODEL=gpt-4.1-mini
BOT_EMBEDDING_MODEL=text-embedding-3-small
BOT_EMBEDDING_DIMENSIONS=512
# Optional: comma-separated group/channel IDs. Empty allows admin activation in any chat.
BOT_ALLOWED_CHAT_IDS=
